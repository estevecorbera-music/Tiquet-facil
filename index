<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Calculadora senzilla per repartir un compte entre persones i grups.">
<title>Compte Fàcil</title>
<style>
  :root {
    --bg: #f5f7fb;
    --card: #ffffff;
    --text: #18202a;
    --muted: #697586;
    --border: #dfe4ec;
    --accent: #315efb;
    --accent-soft: #eef2ff;
    --danger: #c62828;
    --danger-soft: #fff1f1;
    --success: #176b45;
    --shadow: 0 10px 30px rgba(24, 32, 42, .08);
    --radius: 18px;
  }

  * { box-sizing: border-box; }

  html { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  button, input { font: inherit; }

  button { cursor: pointer; }

  .app {
    width: min(760px, calc(100% - 28px));
    margin: 0 auto;
    padding: 28px 0 48px;
  }

  header {
    text-align: center;
    margin-bottom: 24px;
  }

  header h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3rem);
    letter-spacing: -.04em;
  }

  header p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: .98rem;
  }

  .mode-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--card);
    border: 1px solid var(--border);
    padding: 5px;
    border-radius: 14px;
    box-shadow: var(--shadow);
    margin-bottom: 18px;
  }

  .mode-button {
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 12px 10px;
    border-radius: 10px;
    font-weight: 750;
  }

  .mode-button.active {
    background: var(--accent);
    color: white;
  }

  .panel {
    display: grid;
    gap: 16px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px;
  }

  .field label, .section-title {
    display: block;
    font-weight: 750;
    margin-bottom: 8px;
  }

  .field small, .hint {
    display: block;
    color: var(--muted);
    margin-top: 6px;
    font-size: .84rem;
  }

  input[type="number"], input[type="text"] {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 13px;
    background: #fff;
    color: var(--text);
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }

  input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(49, 94, 251, .12);
  }

  .money-input {
    position: relative;
  }

  .money-input input {
    padding-right: 44px;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .money-symbol {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-weight: 750;
    color: var(--muted);
    pointer-events: none;
  }

  .stepper {
    display: grid;
    grid-template-columns: 48px 1fr 48px;
    gap: 8px;
    align-items: center;
  }

  .stepper button {
    height: 48px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    color: var(--text);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .stepper button:hover { background: var(--accent-soft); }

  .stepper input {
    text-align: center;
    font-weight: 750;
    font-size: 1.05rem;
  }

  .result {
    text-align: center;
    border: 1px solid #cfd8ff;
    background: var(--accent-soft);
  }

  .result-label {
    color: var(--muted);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .result-main {
    font-size: clamp(2.25rem, 10vw, 4rem);
    line-height: 1;
    font-weight: 850;
    letter-spacing: -.05em;
    margin: 12px 0 6px;
  }

  .result-sub {
    color: var(--muted);
  }

  .breakdown {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(105, 117, 134, .2);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
  }

  .breakdown-row strong { font-weight: 800; }

  .total-check {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(105, 117, 134, .2);
    font-weight: 800;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .section-head .section-title { margin: 0; }

  .button {
    border: 0;
    border-radius: 11px;
    padding: 11px 14px;
    font-weight: 800;
  }

  .button-primary {
    background: var(--accent);
    color: white;
  }

  .button-secondary {
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid #d5ddff;
  }

  .button-danger {
    background: transparent;
    color: var(--danger);
    padding: 7px 8px;
  }

  .groups {
    display: grid;
    gap: 12px;
  }

  .group-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 15px;
    background: #fff;
  }

  .group-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .group-name {
    font-weight: 800;
    font-size: 1.04rem;
  }

  .group-composition {
    color: var(--muted);
    font-size: .88rem;
    margin-top: 4px;
  }

  .group-price {
    margin-top: 12px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
  }

  .group-price small {
    display: block;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .group-price strong {
    font-size: 1.25rem;
  }

  .group-actions {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .empty {
    border: 1px dashed var(--border);
    border-radius: 14px;
    padding: 20px;
    text-align: center;
    color: var(--muted);
  }

  .coefficient-row {
    display: grid;
    grid-template-columns: 1fr minmax(130px, 180px);
    gap: 14px;
    align-items: end;
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 16, 24, .42);
    display: grid;
    place-items: center;
    padding: 18px;
    z-index: 20;
  }

  .modal {
    width: min(470px, 100%);
    background: #fff;
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 24px 70px rgba(10, 16, 24, .25);
  }

  .modal h2 {
    margin: 0 0 16px;
    font-size: 1.2rem;
  }

  .modal-fields {
    display: grid;
    gap: 14px;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 18px;
  }

  .error {
    color: var(--danger);
    font-size: .83rem;
    margin-top: 6px;
  }

  .hidden { display: none !important; }

  .new-account {
    width: 100%;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    margin-top: 2px;
  }

  .new-account:hover {
    background: #fff;
    color: var(--text);
  }

  @media (max-width: 560px) {
    .app { width: min(100% - 18px, 760px); padding-top: 18px; }
    .card { padding: 16px; }
    .section-head { align-items: stretch; flex-direction: column; }
    .section-head .button { width: 100%; }
    .coefficient-row { grid-template-columns: 1fr; }
    .breakdown-row { align-items: center; }
  }
</style>
</head>
<body>
<div class="app">
  <header>
    <h1>Compte Fàcil</h1>
    <p>Divideix el compte fàcilment</p>
  </header>

  <nav class="mode-switch" aria-label="Mode de repartiment">
    <button class="mode-button active" data-mode="quick">Ràpid</button>
    <button class="mode-button" data-mode="groups">Grups</button>
  </nav>

  <main id="quickPanel" class="panel">
    <section class="card">
      <div class="field">
        <label for="quickTotal">Total del tiquet</label>
        <div class="money-input">
          <input id="quickTotal" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0,00" aria-describedby="quickTotalError">
          <span class="money-symbol">€</span>
        </div>
        <div id="quickTotalError" class="error" aria-live="polite"></div>
      </div>

      <div class="field" style="margin-top:16px;">
        <label for="quickPeople">Nombre de persones</label>
        <div class="stepper">
          <button type="button" id="quickPeopleMinus" aria-label="Reduir nombre de persones">−</button>
          <input id="quickPeople" type="number" inputmode="numeric" min="1" step="1" value="2" aria-describedby="quickPeopleError">
          <button type="button" id="quickPeoplePlus" aria-label="Augmentar nombre de persones">+</button>
        </div>
        <div id="quickPeopleError" class="error" aria-live="polite"></div>
      </div>
    </section>

    <section id="quickResult" class="card result hidden" aria-live="polite"></section>
  </main>

  <main id="groupsPanel" class="panel hidden">
    <section class="card">
      <div class="field">
        <label for="groupsTotal">Total del tiquet</label>
        <div class="money-input">
          <input id="groupsTotal" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0,00" aria-describedby="groupsTotalError">
          <span class="money-symbol">€</span>
        </div>
        <div id="groupsTotalError" class="error" aria-live="polite"></div>
      </div>
    </section>

    <section class="card">
      <div class="section-head">
        <div>
          <span class="section-title">Coeficient dels nens</span>
          <span class="hint">Un adult equival sempre a 1,0 unitats.</span>
        </div>
        <button type="button" class="button button-secondary" id="coefficientButton">Configurar</button>
      </div>
      <div id="coefficientSummary" class="hint">Nen = 0,5 unitats</div>
    </section>

    <section class="card">
      <div class="section-head">
        <div>
          <span class="section-title">Grups</span>
          <span class="hint">Cada grup pot tenir adults i nens.</span>
        </div>
        <button type="button" class="button button-primary" id="addGroupButton">+ Afegir grup</button>
      </div>
      <div id="groupsList" class="groups">
        <div class="empty">Encara no has afegit cap grup.</div>
      </div>
    </section>

    <section id="groupsResult" class="card result hidden" aria-live="polite"></section>
  </main>

  <button type="button" class="button new-account" id="newAccountButton">↻ Nou compte</button>
</div>

<div id="groupModalBackdrop" class="modal-backdrop hidden" role="presentation">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="groupModalTitle">
    <h2 id="groupModalTitle">Nou grup</h2>
    <div class="modal-fields">
      <div class="field">
        <label for="groupName">Nom del grup</label>
        <input id="groupName" type="text" maxlength="80" placeholder="Ex.: Joan + Maria">
        <div id="groupNameError" class="error"></div>
      </div>
      <div class="field">
        <label for="groupAdults">Adults</label>
        <div class="stepper">
          <button type="button" id="groupAdultsMinus" aria-label="Reduir adults">−</button>
          <input id="groupAdults" type="number" inputmode="numeric" min="0" step="1" value="1">
          <button type="button" id="groupAdultsPlus" aria-label="Augmentar adults">+</button>
        </div>
      </div>
      <div class="field">
        <label for="groupChildren">Nens</label>
        <div class="stepper">
          <button type="button" id="groupChildrenMinus" aria-label="Reduir nens">−</button>
          <input id="groupChildren" type="number" inputmode="numeric" min="0" step="1" value="0">
          <button type="button" id="groupChildrenPlus" aria-label="Augmentar nens">+</button>
        </div>
        <div class="hint" id="modalCoefficientHint">Cada nen compta com 0,5 unitats.</div>
      </div>
      <div id="groupCompositionError" class="error"></div>
    </div>
    <div class="modal-actions">
      <button type="button" class="button button-secondary" id="cancelGroupButton">Cancel·lar</button>
      <button type="button" class="button button-primary" id="saveGroupButton">Afegir grup</button>
    </div>
  </div>
</div>

<div id="coefficientModalBackdrop" class="modal-backdrop hidden" role="presentation">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="coefficientModalTitle">
    <h2 id="coefficientModalTitle">Coeficient dels nens</h2>
    <div class="modal-fields">
      <div class="field">
        <label for="coefficientPreset">Valor ràpid</label>
        <select id="coefficientPreset" style="width:100%;min-height:48px;border:1px solid var(--border);border-radius:12px;padding:10px 13px;background:#fff;">
          <option value="0.25">0,25</option>
          <option value="0.5" selected>0,5</option>
          <option value="0.75">0,75</option>
          <option value="custom">Personalitzat</option>
        </select>
      </div>
      <div class="field">
        <label for="coefficientCustom">Coeficient</label>
        <input id="coefficientCustom" type="number" inputmode="decimal" min="0.01" step="0.01" value="0.5">
        <div id="coefficientError" class="error"></div>
      </div>
    </div>
    <div class="modal-actions">
      <button type="button" class="button button-secondary" id="cancelCoefficientButton">Cancel·lar</button>
      <button type="button" class="button button-primary" id="saveCoefficientButton">Desar</button>
    </div>
  </div>
</div>

<script>
(() => {
  "use strict";

  const state = {
    mode: "quick",
    quick: {
      total: "",
      people: 2
    },
    groups: {
      total: "",
      childCoefficient: 0.5,
      items: []
    },
    editingGroupId: null
  };

  const $ = (id) => document.getElementById(id);

  const euro = (cents) => {
    return (cents / 100).toLocaleString("ca-ES", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }) + " €";
  };

  const parseMoneyToCents = (value) => {
    const n = Number(String(value).replace(",", "."));
    if (!Number.isFinite(n) || n < 0) return null;
    return Math.round(n * 100);
  };

  const formatCoefficient = (value) => {
    return Number(value).toLocaleString("ca-ES", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  };

  const escapeHtml = (value) => {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  };

  // Divideix cents proporcionalment i distribueix els cèntims sobrants
  // segons els residus decimals més grans, garantint que la suma quadri.
  const allocateCents = (totalCents, weights) => {
    if (!weights.length) return [];

    const weightSum = weights.reduce((a, b) => a + b, 0);
    if (weightSum <= 0) return weights.map(() => 0);

    const raw = weights.map(w => totalCents * w / weightSum);
    const base = raw.map(Math.floor);
    let remaining = totalCents - base.reduce((a, b) => a + b, 0);

    const order = raw
      .map((v, i) => ({ i, fraction: v - Math.floor(v) }))
      .sort((a, b) => b.fraction - a.fraction || a.i - b.i);

    for (let k = 0; k < remaining; k++) {
      base[order[k % order.length].i] += 1;
    }
    return base;
  };

  function setMode(mode) {
    state.mode = mode;
    document.querySelectorAll(".mode-button").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.mode === mode);
    });
    $("quickPanel").classList.toggle("hidden", mode !== "quick");
    $("groupsPanel").classList.toggle("hidden", mode !== "groups");
    render();
  }

  function validateQuick() {
    const total = parseMoneyToCents($("quickTotal").value);
    const people = Number($("quickPeople").value);

    $("quickTotalError").textContent = total === null || total <= 0 ? "Introdueix un total superior a 0 €." : "";
    $("quickPeopleError").textContent = !Number.isInteger(people) || people < 1 ? "Indica almenys 1 persona." : "";

    return total !== null && total > 0 && Number.isInteger(people) && people >= 1;
  }

  function renderQuick() {
    const result = $("quickResult");
    const total = parseMoneyToCents($("quickTotal").value);
    const people = Number($("quickPeople").value);

    if (total === null || total <= 0 || !Number.isInteger(people) || people < 1) {
      result.classList.add("hidden");
      return;
    }

    const allocations = allocateCents(total, Array(people).fill(1));
    const first = allocations[0];
    const allSame = allocations.every(v => v === first);

    result.classList.remove("hidden");
    result.innerHTML = `
      <div class="result-label">Per persona</div>
      <div class="result-main">${euro(first)}</div>
      <div class="result-sub">${euro(total)} ÷ ${people} ${people === 1 ? "persona" : "persones"}</div>
      ${!allSame ? `
        <div class="breakdown">
          <div class="result-label">Repartiment</div>
          ${allocations.map((c, i) => `
            <div class="breakdown-row">
              <span>Persona ${i + 1}</span>
              <strong>${euro(c)}</strong>
            </div>
          `).join("")}
        </div>
      ` : ""}
      <div class="total-check">Total repartit: ${euro(allocations.reduce((a,b) => a+b, 0))}</div>
    `;
  }

  function validateGroupsTotal() {
    const total = parseMoneyToCents($("groupsTotal").value);
    $("groupsTotalError").textContent = total === null || total <= 0 ? "Introdueix un total superior a 0 €." : "";
    return total !== null && total > 0;
  }

  function groupUnits(group) {
    return group.adults + group.children * state.groups.childCoefficient;
  }

  function renderGroups() {
    const list = $("groupsList");
    if (!state.groups.items.length) {
      list.innerHTML = `<div class="empty">Encara no has afegit cap grup.</div>`;
      $("groupsResult").classList.add("hidden");
      return;
    }

    list.innerHTML = state.groups.items.map(group => {
      const composition = [];
      if (group.adults) composition.push(`${group.adults} ${group.adults === 1 ? "adult" : "adults"}`);
      if (group.children) composition.push(`${group.children} ${group.children === 1 ? "nen" : "nens"}`);

      return `
        <article class="group-card">
          <div class="group-top">
            <div>
              <div class="group-name">${escapeHtml(group.name)}</div>
              <div class="group-composition">${composition.join(" · ")}</div>
            </div>
            <div class="group-actions">
              <button type="button" class="button button-secondary edit-group" data-id="${group.id}" aria-label="Editar ${escapeHtml(group.name)}">Editar</button>
              <button type="button" class="button button-danger delete-group" data-id="${group.id}" aria-label="Eliminar ${escapeHtml(group.name)}">Eliminar</button>
            </div>
          </div>
          <div class="group-price">
            <div>
              <small>${formatCoefficient(groupUnits(group))} unitats</small>
              <span class="hint">Coeficient total del grup</span>
            </div>
            <strong data-price-id="${group.id}">--</strong>
          </div>
        </article>
      `;
    }).join("");

    list.querySelectorAll(".edit-group").forEach(btn => {
      btn.addEventListener("click", () => openGroupModal(btn.dataset.id));
    });

    list.querySelectorAll(".delete-group").forEach(btn => {
      btn.addEventListener("click", () => {
        state.groups.items = state.groups.items.filter(g => g.id !== btn.dataset.id);
        renderGroups();
      });
    });

    renderGroupResult();
  }

  function renderGroupResult() {
    const result = $("groupsResult");
    const total = parseMoneyToCents($("groupsTotal").value);
    const items = state.groups.items;

    if (total === null || total <= 0 || !items.length) {
      result.classList.add("hidden");
      items.forEach(g => {
        const el = document.querySelector(`[data-price-id="${g.id}"]`);
        if (el) el.textContent = "--";
      });
      return;
    }

    const weights = items.map(groupUnits);
    if (weights.some(w => w <= 0)) {
      result.classList.add("hidden");
      return;
    }

    const totalUnits = weights.reduce((a,b) => a+b, 0);
    const allocations = allocateCents(total, weights);

    items.forEach((g, i) => {
      const el = document.querySelector(`[data-price-id="${g.id}"]`);
      if (el) el.textContent = euro(allocations[i]);
    });

    const unitValue = total / 100 / totalUnits;

    result.classList.remove("hidden");
    result.innerHTML = `
      <div class="result-label">Per unitat</div>
      <div class="result-main">${unitValue.toLocaleString("ca-ES", {minimumFractionDigits:2, maximumFractionDigits:2})} €</div>
      <div class="result-sub">${totalUnits.toLocaleString("ca-ES", {maximumFractionDigits:2})} unitats en total</div>
      <div class="breakdown">
        <div class="result-label">Repartiment</div>
        ${items.map((g, i) => {
          const composition = [];
          if (g.adults) composition.push(`${g.adults} ${g.adults === 1 ? "adult" : "adults"}`);
          if (g.children) composition.push(`${g.children} ${g.children === 1 ? "nen" : "nens"}`);
          return `
            <div class="breakdown-row">
              <span>
                <strong>${escapeHtml(g.name)}</strong><br>
                <small style="color:var(--muted)">${composition.join(" · ")}</small>
              </span>
              <strong>${euro(allocations[i])}</strong>
            </div>
          `;
        }).join("")}
      </div>
      <div class="total-check">Total repartit: ${euro(allocations.reduce((a,b) => a+b, 0))}</div>
    `;
  }

  function render() {
    if (state.mode === "quick") {
      renderQuick();
    } else {
      $("coefficientSummary").textContent = `Nen = ${formatCoefficient(state.groups.childCoefficient)} unitats`;
      $("modalCoefficientHint").textContent = `Cada nen compta com ${formatCoefficient(state.groups.childCoefficient)} unitats.`;
      renderGroups();
    }
  }

  function setStepper(input, delta, min = 0) {
    const current = Number(input.value);
    const safe = Number.isFinite(current) ? current : min;
    input.value = Math.max(min, Math.floor(safe) + delta);
    input.dispatchEvent(new Event("input", { bubbles: true }));
  }

  function openGroupModal(id = null) {
    state.editingGroupId = id;
    const group = id ? state.groups.items.find(g => g.id === id) : null;

    $("groupModalTitle").textContent = group ? "Editar grup" : "Nou grup";
    $("saveGroupButton").textContent = group ? "Desar canvis" : "Afegir grup";
    $("groupName").value = group ? group.name : "";
    $("groupAdults").value = group ? group.adults : 1;
    $("groupChildren").value = group ? group.children : 0;
    $("groupNameError").textContent = "";
    $("groupCompositionError").textContent = "";
    $("groupModalBackdrop").classList.remove("hidden");
    setTimeout(() => $("groupName").focus(), 0);
  }

  function closeGroupModal() {
    $("groupModalBackdrop").classList.add("hidden");
    state.editingGroupId = null;
  }

  function saveGroup() {
    const name = $("groupName").value.trim();
    const adults = Number($("groupAdults").value);
    const children = Number($("groupChildren").value);

    $("groupNameError").textContent = "";
    $("groupCompositionError").textContent = "";

    if (!name) {
      $("groupNameError").textContent = "Posa un nom al grup.";
      return;
    }
    if (!Number.isInteger(adults) || adults < 0 || !Number.isInteger(children) || children < 0) {
      $("groupCompositionError").textContent = "Adults i nens han de ser nombres enters iguals o superiors a 0.";
      return;
    }
    if (adults + children < 1) {
      $("groupCompositionError").textContent = "El grup ha de tenir almenys una persona.";
      return;
    }

    if (state.editingGroupId) {
      const group = state.groups.items.find(g => g.id === state.editingGroupId);
      Object.assign(group, { name, adults, children });
    } else {
      state.groups.items.push({
        id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()),
        name,
        adults,
        children
      });
    }

    closeGroupModal();
    renderGroups();
  }

  function openCoefficientModal() {
    const c = state.groups.childCoefficient;
    const presetValues = ["0.25", "0.5", "0.75"];
    $("coefficientPreset").value = presetValues.includes(String(c)) ? String(c) : "custom";
    $("coefficientCustom").value = c;
    $("coefficientError").textContent = "";
    $("coefficientModalBackdrop").classList.remove("hidden");
  }

  function closeCoefficientModal() {
    $("coefficientModalBackdrop").classList.add("hidden");
  }

  function saveCoefficient() {
    const value = Number($("coefficientCustom").value);
    if (!Number.isFinite(value) || value <= 0) {
      $("coefficientError").textContent = "El coeficient ha de ser superior a 0.";
      return;
    }
    state.groups.childCoefficient = value;
    closeCoefficientModal();
    renderGroups();
  }

  // Mode
  document.querySelectorAll(".mode-button").forEach(btn => {
    btn.addEventListener("click", () => setMode(btn.dataset.mode));
  });

  // Quick inputs
  $("quickTotal").addEventListener("input", () => {
    state.quick.total = $("quickTotal").value;
    validateQuick();
    renderQuick();
  });

  $("quickPeople").addEventListener("input", () => {
    state.quick.people = $("quickPeople").value;
    validateQuick();
    renderQuick();
  });

  $("quickPeopleMinus").addEventListener("click", () => setStepper($("quickPeople"), -1, 1));
  $("quickPeoplePlus").addEventListener("click", () => setStepper($("quickPeople"), 1, 1));

  // Group total
  $("groupsTotal").addEventListener("input", () => {
    state.groups.total = $("groupsTotal").value;
    validateGroupsTotal();
    renderGroupResult();
  });

  // Group modal steppers
  $("groupAdultsMinus").addEventListener("click", () => setStepper($("groupAdults"), -1, 0));
  $("groupAdultsPlus").addEventListener("click", () => setStepper($("groupAdults"), 1, 0));
  $("groupChildrenMinus").addEventListener("click", () => setStepper($("groupChildren"), -1, 0));
  $("groupChildrenPlus").addEventListener("click", () => setStepper($("groupChildren"), 1, 0));

  $("addGroupButton").addEventListener("click", () => openGroupModal());
  $("cancelGroupButton").addEventListener("click", closeGroupModal);
  $("saveGroupButton").addEventListener("click", saveGroup);

  $("coefficientButton").addEventListener("click", openCoefficientModal);
  $("cancelCoefficientButton").addEventListener("click", closeCoefficientModal);
  $("saveCoefficientButton").addEventListener("click", saveCoefficient);

  $("coefficientPreset").addEventListener("change", () => {
    if ($("coefficientPreset").value !== "custom") {
      $("coefficientCustom").value = $("coefficientPreset").value;
    }
  });

  $("newAccountButton").addEventListener("click", () => {
    const hasData =
      $("quickTotal").value ||
      $("quickPeople").value !== "2" ||
      $("groupsTotal").value ||
      state.groups.items.length;

    if (!hasData) return;

    const confirmed = window.confirm("Vols començar un compte nou? Esborraràs les dades actuals.");
    if (!confirmed) return;

    $("quickTotal").value = "";
    $("quickPeople").value = "2";
    $("groupsTotal").value = "";
    state.quick.total = "";
    state.quick.people = 2;
    state.groups.total = "";
    state.groups.items = [];
    state.groups.childCoefficient = 0.5;
    render();
  });

  // Tanca els modals fent clic al fons.
  $("groupModalBackdrop").addEventListener("click", e => {
    if (e.target === $("groupModalBackdrop")) closeGroupModal();
  });
  $("coefficientModalBackdrop").addEventListener("click", e => {
    if (e.target === $("coefficientModalBackdrop")) closeCoefficientModal();
  });

  // Escape tanca els modals.
  document.addEventListener("keydown", e => {
    if (e.key === "Escape") {
      if (!$("groupModalBackdrop").classList.contains("hidden")) closeGroupModal();
      if (!$("coefficientModalBackdrop").classList.contains("hidden")) closeCoefficientModal();
    }
  });

  render();
})();
</script>
</body>
</html>
